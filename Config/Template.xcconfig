APP_BUNDLE_IDENTIFIER = com.example.AppTemplate
APP_URL_SCHEME = apptemplate
APP_DEVELOPMENT_TEAM = 33W8WHD42N

// Applies to every target, so the app and its test bundles share one Team ID.
// macOS refuses to load a test bundle whose team differs from the host app.
DEVELOPMENT_TEAM = $(APP_DEVELOPMENT_TEAM)

// Visible copy goes through AppText into the AppText catalog. Xcode's extractor
// sees the literal at the call site but not the table the facade passes, so with
// extraction on it refills Localizable.xcstrings with a duplicate of every key on
// each build. The catalogs are maintained by hand and AppTextLocalizationTests
// fails when a producer uses a key the catalog lacks.
SWIFT_EMIT_LOC_STRINGS = NO

// Warnings are errors for first-party code only. Passing this on the xcodebuild
// command line also reaches SPM package targets, which Xcode builds with
// -suppress-warnings; swiftc rejects that pair outright, so the release gate
// would fail inside Nuke on every run. This xcconfig is the project-level
// baseConfigurationReference, so it reaches all three first-party targets and
// never reaches the synthesized package project.
SWIFT_TREAT_WARNINGS_AS_ERRORS = YES
